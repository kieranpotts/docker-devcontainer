#!/usr/bin/env sh
set -e

script_dir="$(dirname "$0")"
dockerfile="${script_dir}/../src/Dockerfile"
image="kieranpotts/devcontainer:latest"

if [ -z "${BOOTSTRAP_VERSION}" ] || [ -z "${DOTFILES_VERSION}" ]; then
  echo "Error: BOOTSTRAP_VERSION and DOTFILES_VERSION must be set, eg." >&2
  echo "  BOOTSTRAP_VERSION=v1.3.0 DOTFILES_VERSION=v1.0.0 make build" >&2
  exit 1
fi

echo "Building ${image} (bootstrap ${BOOTSTRAP_VERSION}, dotfiles ${DOTFILES_VERSION})..."
docker build \
  --build-arg "BOOTSTRAP_VERSION=${BOOTSTRAP_VERSION}" \
  --build-arg "DOTFILES_VERSION=${DOTFILES_VERSION}" \
  --tag "${image}" \
  --file "${dockerfile}" \
  .

echo "Done."
