#!/usr/bin/env sh
set -e

# Docker runs on the host only. The workspace devcontainer has no Docker, so
# stop with a clear message there, rather than `docker: command not found`.
if ! command -v docker >/dev/null 2>&1; then
  echo "Error: Docker not found. Run this script in a terminal on the host, not in the devcontainer." >&2
  exit 1
fi

if [ -z "${DOCKER_USERNAME}" ] || [ -z "${DOCKER_TOKEN}" ]; then
  echo "Error: DOCKER_USERNAME and DOCKER_TOKEN must be set"
  exit 1
fi

version=$(git describe --tags --exact-match 2>/dev/null | sed 's/^v//')
if [ -z "${version}" ]; then
  echo "Error: HEAD is not on a Git tag. Tag the commit (eg. git tag v1.0.0) before publishing."
  exit 1
fi

echo "Publishing v${version}..."

echo "${DOCKER_TOKEN}" | docker login -u "${DOCKER_USERNAME}" --password-stdin

image="kieranpotts/devcontainer"
latest="${image}:latest"
versioned="${image}:${version}"

docker tag "${latest}" "${versioned}"

docker push "${latest}"
docker push "${versioned}"

docker logout

echo "Done."
